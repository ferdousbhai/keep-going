{
  "name": "@ferdousbhai/keep-going",
  "version": "0.9.0",
  "description": "Tell Codex, Claude Code, Muse Code, Ghost, Grok, and Pi to keep going when work remains.",
  "type": "module",
  "license": "MIT",
  "author": "Ferdous Bhai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ferdousbhai/keep-going.git"
  },
  "homepage": "https://github.com/ferdousbhai/keep-going#readme",
  "bugs": "https://github.com/ferdousbhai/keep-going/issues",
  "bin": {
    "keep-going": "scripts/install.mjs"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/keep-going.js"
    ]
  },
  "files": [
    "extensions",
    "plugins/keep-going",
    "scripts/hosts.mjs",
    "scripts/install.mjs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "test:pi": "node --test test/pi.integration.mjs",
    "check": "npm run build && npm test"
  },
  "devDependencies": {
    "esbuild": "0.25.9"
  },
  "engines": {
    "node": ">=22"
  },
  "private": true
}
